# Platform connection. Store real values outside Git.
APP_URL=https://app.11agents.ai
EMAIL=
PASSWORD=

# Google Ads account identifiers are configuration, not credentials.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Safety gates. Keep both disabled until an approved cutover.
ARMED=0
ALLOW_ENABLE=0
# Revenue uploads are a separate Google Ads write gate. Both this and ARMED must
# be 1; keep 0 until purchase/refund QA and conversion-action review are signed.
ENABLE_REVENUE_UPLOADS=0
ADS_MUTATION_APPROVED=0

# Runtime cadence and external secret-file locations.
POLL_SECONDS=300
GOOGLE_ADS_ENV=~/.config/gtm-swarm/google-ads.env
ADS_PROJECT_TOKENS_FILE=~/.config/gtm-swarm/project-tokens
ADS_MCP_URL=https://app.11agents.ai/mcp
