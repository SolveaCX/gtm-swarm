# Platform connection. Store real values outside Git.
APP_URL=https://app.11agents.ai
EMAIL=
PASSWORD=

# Google Ads account identifiers are configuration, not credentials.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Safety gates. Keep both disabled until an approved cutover.
ARMED=0
ALLOW_ENABLE=0
# Revenue uploads are a separate Google Ads write gate. Both this and ARMED must
# be 1; keep 0 until purchase/refund QA and conversion-action review are signed.
ENABLE_REVENUE_UPLOADS=0
ADS_MUTATION_APPROVED=0

# Runtime cadence and external secret-file locations.
POLL_SECONDS=300
GOOGLE_ADS_ENV=~/.config/gtm-swarm/google-ads.env
ADS_PROJECT_TOKENS_FILE=~/.config/gtm-swarm/project-tokens
ADS_MCP_URL=https://app.11agents.ai/mcp

# X Ads read-only telemetry. Prefer macOS Keychain services documented in
# README.md; these explicit env values are supported for managed runtimes.
X_ADS_API_KEY=
X_ADS_API_SECRET=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN_SECRET=

# GTM telemetry ingest token. Prefer the workspace-scoped name so one process
# cannot silently reuse another workspace's token. `pricing-analyse` is the
# production GTM workspace slug whose display name is Flatkey.
GTM_SWARM_TOKEN_PRICING_ANALYSE=
# Generic fallback for a runtime that executes exactly one workspace config.
GTM_SWARM_TOKEN=
# Keychain alternative: service `gtm-swarm-workspace-token`, account set to
# the exact workspace slug (for Flatkey: `pricing-analyse`).
